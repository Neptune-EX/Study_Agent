\ifx\bbl@chfmt\@undefined\else
  \EditInstance{heading}{chapter}{%
    prefix =,
    number-format = \unskip\unskip\bbl@chfmt
   }
\fi
\ifx\bbl@partformat\@undefined\else
  \EditInstance{heading}{part}{%
    prefix =,
    number-format = \unskip\unskip\bbl@partformat
   }
\fi
\@ifpackagewith{babel}{babel-metadata=tagging}{}{\endinput}
\let\bbl@ifmetadata\IfDocumentMetadataT
\ExplSyntaxOn
\ifnum\bbl@bidimode>\z@
  \tagpdfsetup{
    role/new-attribute = {babel-dir-rl}{/O/Layout/WritingMode/RlTb},
    role/new-attribute = {babel-dir-lr}{/O/Layout/WritingMode/LrTb} }
\fi
\AddToHook{begindocument/end}{%
  \ifnum\bbl@bidimode>\z@
    \ifcase\bbl@thepardir\else
      \tag_struct_gput:nnn{\tag_get:n{struct_num}}{attribute}{/O/Layout/WritingMode/RlTb}%
    \fi
  \fi}
\NewTaggingSocket{babel/foreign/begin}{0}
\NewTaggingSocket{babel/foreign/end}{0}
\NewTaggingSocketPlug{babel/foreign/begin}{default}{
  \tag_mc_end_push:
  \bbl@array@get\bbl@select@opts{phoneme}\bbl@tempa
  \ifx\bbl@tempa\relax\let\bbl@tempa\@empty\fi
  \bbl@array@get\bbl@select@opts{actualtext}\bbl@tempb
  \ifx\bbl@tempb\relax\let\bbl@tempb\@empty\fi
  \bbl@exp{%
    \\\tagstructbegin{tag=Span, lang=\BCPdata{tag},
      \ifnum\bbl@bidimode>\z@
        attribute=babel-dir-\ifcase\bbl@thetextdir lr\else rl\fi,
      \fi
      phoneme={\bbl@tempa}, actualtext={\bbl@tempb}}}%
  \tagmcbegin {} }
\NewTaggingSocketPlug{babel/foreign/end}{default}{
  \tagmcend
  \tagstructend
  \tag_mc_begin_pop:n {}}
\AssignTaggingSocketPlug{babel/foreign/begin}{default}
\AssignTaggingSocketPlug{babel/foreign/end}{default}
\ExplSyntaxOff
\AddBabelHook{babel-pdftagging}{afterextras}{%
  \IfBabelSelectorTF{select}%
    {\ifvmode
       \bbl@ifsamestring{\BCPdata{tag}}{\BCPdata{main.tag}}%
         {\tagpdfsetup{text/lang=}}
         {\tagpdfsetup{text/lang=\BCPdata{tag}}}%
     \else
       \bbl@once{select-tag-vmode}{%
         \bbl@warning{%
           PDF language tagging with \string\selectlanguage\\%
           requires vertical mode. Reported}}%
     \fi}%
    {}}
\endinput
